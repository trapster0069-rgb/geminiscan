{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/refreshLink",
      "destination": "/api"
    },
    {
      "source": "/go/(.*)",
      "destination": "/api"
    },
    {
      "source": "/new/gm/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
